# Street Vendor Digitalization Agent - Environment Configuration
# Copy this file to .env and fill in your IBM Cloud credentials.
# Never commit the actual .env file to version control.

# -------------------------------------------------------------------
# IBM Cloud / watsonx.ai Credentials (REQUIRED)
# -------------------------------------------------------------------

# Your IBM Cloud API key (IAM)
IBM_API_KEY=ePAPrVkWmO3Jc0ROUNBRaswg5AEc1NLtfmjpZHtFYXp2

# Your watsonx.ai Project ID
IBM_PROJECT_ID=427df7e4-043b-45ae-b245-a1aba3fe09f0

# watsonx.ai regional endpoint (default: us-south)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# -------------------------------------------------------------------
# IBM Granite Model Configuration
# -------------------------------------------------------------------

# Model ID to use for text generation
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Maximum tokens per generation response
GRANITE_MAX_TOKENS=1024

# Temperature (0.0 = deterministic, 1.0 = creative)
GRANITE_TEMPERATURE=0.7

# Top-P nucleus sampling
GRANITE_TOP_P=0.9

# -------------------------------------------------------------------
# Flask Server Configuration
# -------------------------------------------------------------------

FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Set to true only during local development
FLASK_DEBUG=false

# Random secret key for Flask session security
SECRET_KEY=replace-with-a-random-secret-key

# -------------------------------------------------------------------
# RAG Configuration
# -------------------------------------------------------------------

# Maximum number of sources retrieved per query
RAG_MAX_SOURCES=4
